# Salin sebagai Environment Variables di dashboard Cloudflare Pages.
# VITE_SITE_URL boleh dikosongkan — CF_PAGES_URL dari Cloudflare dipakai otomatis.
# Isi hanya jika memakai custom domain, contoh: https://cvgyhonpetrulia.my.id/
VITE_SITE_URL=

# Dapatkan gratis di Cloudflare dashboard > Web Analytics > Add a site.
# Kosongkan jika belum ingin memasang analytics.
VITE_CF_WEB_ANALYTICS_TOKEN=
